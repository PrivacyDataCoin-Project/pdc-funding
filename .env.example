# Copy to .env and adjust. Empty WALLET_RPC_URL = dry-run (no chain I/O).

SECRET_KEY=change-me-to-a-long-random-string
BIND_HOST=127.0.0.1
BIND_PORT=8088
SITE_NAME=PDC Funding
DATABASE_PATH=data/funding.db

# Wallet RPC (PDC / Zano-compatible simplewallet). Leave empty for dry-run.
WALLET_RPC_URL=
WALLET_RPC_USER=
WALLET_RPC_PASSWORD=
DAEMON_RPC_URL=http://127.0.0.1:19211
PDC_ASSET_ID=d6329b5b1f7c0805b5c345f4957554002a2f557845f64d7645dae0e051a6498a
TRANSFER_FEE_ATOMIC=10000000000
DEPOSIT_MIN_CONFIRMATIONS=10
DEPOSIT_SCAN_INTERVAL_SEC=30

# Trade USD prices (oracle-backed when enabled on Trade)
PRICES_USD_URL=https://api.trade.privacydatacoin.com/api/prices/usd
EXPLORER_TX_URL=https://explorer.privacydatacoin.com/transaction/

# Bootstrap first admin (created only if users table is empty)
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
