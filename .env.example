# Copy to .env and adjust. Empty WALLET_RPC_URL = dry-run (no chain I/O).

# Long random value. Placeholder secrets are refused when BIND_HOST is not loopback.
SECRET_KEY=change-me-to-a-long-random-string
BIND_HOST=127.0.0.1
BIND_PORT=8095
SITE_NAME=PDC Funding
DATABASE_PATH=data/funding.db
# Set to 1 behind HTTPS (production nginx TLS)
SESSION_HTTPS_ONLY=0

# Wallet RPC (PDC / Zano-compatible simplewallet). Leave empty for dry-run.
WALLET_RPC_URL=
WALLET_RPC_USER=
WALLET_RPC_PASSWORD=
DAEMON_RPC_URL=http://127.0.0.1:19211
PDC_ASSET_ID=d6329b5b1f7c0805b5c345f4957554002a2f557845f64d7645dae0e051a6498a
BTCX_ASSET_ID=c2bf0410873b49ec7e7dd19d62bca9625d80cd3123670a67b48d997d3127426d
TRANSFER_FEE_ATOMIC=10000000000
# L1 fee for PDC/BTCX is TRANSFER_FEE_ATOMIC from proposal PDC escrow (hard model).
# BTC miner fee is subtracted from the BTC payout amount on-chain.
BTCX_TRANSFER_FEE_ATOMIC=0
BTC_TRANSFER_FEE_SATS=1000
DEPOSIT_MIN_CONFIRMATIONS=10
DEPOSIT_SCAN_INTERVAL_SEC=30

# Native BTC escrow via Bitcoin Core named wallet "funding" (NOT the bridge wallet).
# Leave BTC_RPC_URL empty for dry-run. Secrets live under /etc/pdc-secrets/funding-btc.*
BTC_RPC_URL=
BTC_RPC_USER=
BTC_RPC_PASSWORD=
BTC_WALLET_NAME=funding
BTC_MIN_CONFIRMATIONS=3
BTC_EXPLORER_TX_URL=https://mempool.space/tx/

# Trade USD prices (oracle-backed when enabled on Trade)
PRICES_USD_URL=https://api.trade.privacydatacoin.com/api/prices/usd
EXPLORER_TX_URL=https://explorer.privacydatacoin.com/transaction/

# Bootstrap first admin (created only if users table is empty)
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# TOTP (2FA) — 64-hex or passphrase (SHA-256). Required to encrypt authenticator secrets.
FUNDING_TOTP_KEK=change-me-to-a-long-random-passphrase-or-64hex
TOTP_ISSUER=PDC Funding
